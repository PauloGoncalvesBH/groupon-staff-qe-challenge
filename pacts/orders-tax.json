{
  "consumer": {
    "name": "orders"
  },
  "interactions": [
    {
      "description": "valid request returns taxAmount plus ignored field",
      "providerStates": [
        {
          "name": "Provider may include extra fields"
        }
      ],
      "request": {
        "body": {
          "amount": 50.0,
          "currency": "BRL",
          "userId": "user-xyz"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.amount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            },
            "$.currency": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.userId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/tax/calc"
      },
      "response": {
        "body": {
          "ignored": "anything",
          "taxAmount": 4.0
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.ignored": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.taxAmount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "valid request returns taxAmount",
      "providerStates": [
        {
          "name": "Tax service can compute tax for USD"
        }
      ],
      "request": {
        "body": {
          "amount": 100.0,
          "currency": "USD",
          "userId": "user-abc"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.amount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            },
            "$.currency": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.userId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/tax/calc"
      },
      "response": {
        "body": {
          "taxAmount": 10.0
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.taxAmount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.6.15"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "tax"
  }
}
